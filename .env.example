# =====================================================================
# SAMAR - konfigurasi. SEMUA OPSIONAL untuk menjalankan di laptop:
#   npm install && npm start   (tanpa file .env, tanpa database, tanpa Docker)
# Salin file ini menjadi .env hanya jika ingin mengubah sesuatu.
# =====================================================================

# --- Database (OPSIONAL) -------------------------------------------------
# Kosong  = data disimpan di folder data/ (tanpa database).
# Diisi   = otomatis memakai Postgres/Neon. Ambil connection string dari dashboard Neon
#           (Connection Details -> pilih "Pooled connection" juga boleh).
# Contoh  : postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Secret (WAJIB bila NODE_ENV=production; saat development dibuat otomatis) ----
# Buat dengan:  npm run gen-secrets
JWT_SECRET=
HMAC_MASTER_KEY=
INTERNAL_API_KEY=

# --- Mode ------------------------------------------------------------------
NODE_ENV=development
# DEMO_MODE: akun demo, skenario simulasi, Inspektur Data, mode baseline. Default: true jika bukan production.
# Untuk demo publik di Railway (NODE_ENV=production) set DEMO_MODE=true secara eksplisit.
DEMO_MODE=
# true = hanya menerima NIK sintetis berawalan 9999 (aturan lomba: dilarang data peserta JKN riil)
SYNTHETIC_ONLY=true
DEFAULT_MODE=proposed
# Izinkan mode baseline (pembanding tanpa SAMAR). Default: sama dengan DEMO_MODE.
ALLOW_BASELINE_MODE=

# --- Jaringan --------------------------------------------------------------
# Port Gateway (UI + API). Railway mengisi PORT otomatis.
PORT=3000
# Port internal (hanya 127.0.0.1): ubah bila bentrok dengan aplikasi lain
AUTH_PORT=4101
PRIVACY_PORT=4102
CLAIMS_PORT=4103
FRAUD_PORT=4104
NOTIFY_PORT=4105
# Isi bila UI di-host terpisah (mis. Vercel): domain UI, pisahkan koma bila lebih dari satu
ALLOWED_ORIGIN=
# Di balik reverse proxy (Railway/Render/Nginx) isi 1
TRUST_PROXY=0

# --- Kebijakan privasi & keamanan -----------------------------------------
# Masa berlaku epoch token (detik). Default 30 hari. Token berotasi tiap epoch.
TOKEN_TTL_SECONDS=2592000
# Kuota pembukaan identitas per verifikator per jam
REIDENTIFY_MAX_PER_HOUR=10
# Batas permintaan per menit per IP (API) dan login GAGAL per menit per IP
RATE_LIMIT_PER_MIN=600
LOGIN_MAX_FAILS_PER_MIN=20

# --- Produksi: daftar pengguna (menggantikan akun demo) ---------------------
# AUTH_USERS_JSON=[{"username":"faskes1","password":"ganti-ini","role":"facility","facility_id":"RS-A","name":"RS Contoh"},{"username":"ver1","password":"ganti-ini-juga","role":"verifier","name":"Verifikator"}]
AUTH_USERS_JSON=

LOG_LEVEL=info
